            "debuggerArgs": [
                "-nx"
            ],
            "armToolchainPath": "C:/Users/30952/.eide/tools/gcc_arm/bin",
            "openOCDLaunchCommands": [
                "adapter speed 100",
                "reset_config none",
                "cortex_m reset_config sysresetreq"
            ],
            "serverArgs": [
                "-d2"
            ],
            "preLaunchTask": "prepare GDB",
