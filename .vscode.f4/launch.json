            "executable": "${workspaceFolder}/build/Debug/jixiebi1.elf",
            "loadFiles": [],
            "device": "STM32F407ZG",
            "configFiles": [
                "${workspaceFolder}/.vscode/debug/stlink-swd.cfg",
                "target/stm32f4x.cfg"
